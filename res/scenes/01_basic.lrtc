# Escena 1: Figuras Básicas
# Este es un comentario

# Cámara
# C <position> <normal> <aspect_ratio> <image width> <samples_per_pixel> <depth> <fov> <normal_weight> <position_weight> <albedo_weight> <color_weight>
C 0,2.75,-8 0,-0.75,1.0 1.7777777 1500 2500 25 90 0.25 0.25 0.25 0.25

# Suelo (Esfera gigante)
# sp <position> <radius> <albedo> <roughness> <metalness> <transmission> <ior> <emission> <emission_strength>
sp 0,-100.5,-1 100 1,1,1 0.8 0 0 1 0,0,0 0

# Esferas
sp 0,0.5,-2 0.5 1,0.2,0.2 0.1 0 0 1 0,0,0 0
sp 1.5,0.5,-2 0.5 0.2,1,0.2 0.1 1 0 1 0,0,0 0
sp -1.5,0.5,-2 0.5 0.2,0.2,1 0 0 1 1.5 0,0,0 0

# Cilindro
# cy <pos> <normal> <radius> <height> <albedo> <roughness> <metalness> <transm> <ior> <emission> <em_strength>
cy 3,0,-1 0.25,1,-0.25 0.5 1 1,1,0 0.2 0 0 1 0,0,0 0

# Cono
co -3,0,-1 0,1,0 0.5 1 0,1,1 0.2 0 0 1 0,0,0 0

# Toroide
# to <pos> <normal> <minor_r> <major_r> ...
to 0,2,-2 1,1,0 0.2 0.8 1,0,1 0.1 0.5 0 1 0,0,0 0

# Luz emisiva
sp 0,5,-2 1 1,1,1 1 0 0 1 1,1,1 10
